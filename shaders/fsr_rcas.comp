#version 450
#extension GL_GOOGLE_include_directive : require
#define A_GPU 1
#define A_GLSL 1
#define FSR_RCAS_F 1
#include "fsr1/ffx_a.h"
layout(local_size_x=8, local_size_y=8) in;
layout(set=0, binding=0) uniform sampler2D source_image;
layout(set=0, binding=1, rgba16f) uniform writeonly image2D output_image;
layout(push_constant) uniform Constants { uvec4 con; } pc;
AF4 FsrRcasLoadF(ASU2 p) {
    return texelFetch(source_image, clamp(p, ivec2(0), textureSize(source_image,0)-1), 0);
}
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "fsr1/ffx_fsr1.h"
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, uvec2(imageSize(output_image))))) return;
    vec3 color;
    FsrRcasF(color.r, color.g, color.b, p, pc.con);
    imageStore(output_image, ivec2(p), vec4(color, 1));
}
