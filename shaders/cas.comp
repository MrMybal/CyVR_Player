#version 450
#extension GL_GOOGLE_include_directive : require
#define A_GPU 1
#define A_GLSL 1
#include "cas/ffx_a.h"
layout(local_size_x=8, local_size_y=8) in;
layout(set=0, binding=0) uniform sampler2D source_image;
layout(set=0, binding=1, rgba16f) uniform writeonly image2D output_image;
layout(push_constant) uniform Constants { uvec4 con0; uvec4 con1; } pc;
// The source is an eye-isolated, linear RGB [0,1] texture. Never sample a
// packed SBS/TB source directly: the kernel must not bleed across eyes.
AF3 CasLoad(ASU2 p) {
    return texelFetch(source_image, clamp(p, ivec2(0), textureSize(source_image,0)-1), 0).rgb;
}
void CasInput(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "cas/ffx_cas.h"
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, uvec2(imageSize(output_image))))) return;
    vec3 color;
    CasFilter(color.r, color.g, color.b, p, pc.con0, pc.con1, true);
    imageStore(output_image, ivec2(p), vec4(color, 1));
}
