# The upstream decoder is a single amalgamated C translation unit. Keep its
# sources intact; use the same required compiler options as its Makefile.
set(CYVR_EDGE264_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.deps/edge264/source" CACHE PATH "edge264-mvc source")
if(NOT EXISTS "${CYVR_EDGE264_ROOT}/edge264mvc.h")
    message(FATAL_ERROR "Prepare BSD decoders first: python tools/build_codecs.py")
endif()
enable_language(C)
add_library(cyvr_edge264 STATIC "${CYVR_EDGE264_ROOT}/src/edge264mvc.c")
set_target_properties(cyvr_edge264 PROPERTIES POSITION_INDEPENDENT_CODE ON C_STANDARD 11 C_EXTENSIONS ON)
target_include_directories(cyvr_edge264 PUBLIC "${CYVR_EDGE264_ROOT}")
target_compile_definitions(cyvr_edge264 PRIVATE NDEBUG EDGE264MVC_VERSION_STRING="4555276")
target_compile_options(cyvr_edge264 PRIVATE -O3 -fwrapv -flax-vector-conversions -Wno-override-init)
if(ANDROID)
    target_compile_options(cyvr_edge264 PRIVATE -march=armv8-a+simd)
endif()
if(WIN32)
    target_compile_definitions(cyvr_edge264 PRIVATE _AMD64_)
    target_compile_options(cyvr_edge264 PRIVATE -fms-extensions)
endif()
if(NOT WIN32)
    target_link_libraries(cyvr_edge264 PUBLIC m)
endif()
