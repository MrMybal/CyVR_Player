if(NOT CYVR_PLAYER_FFMPEG_ROOT)
    if(ANDROID)
        set(CYVR_PLAYER_FFMPEG_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.deps/ffmpeg/android-arm64" CACHE PATH "FFmpeg SDK prefix")
    else()
        set(CYVR_PLAYER_FFMPEG_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.deps/ffmpeg/windows" CACHE PATH "FFmpeg SDK prefix")
    endif()
endif()
if(NOT EXISTS "${CYVR_PLAYER_FFMPEG_ROOT}/include/libavformat/avformat.h")
    message(FATAL_ERROR "FFmpeg SDK missing. Run tools/fetch_ffmpeg.py (Windows) or prepare/build_ffmpeg_android.py (Android), or set CYVR_PLAYER_FFMPEG_ROOT.")
endif()
foreach(component avformat avcodec avutil swresample swscale)
    add_library(cyvr_ffmpeg_${component} SHARED IMPORTED)
    set_target_properties(cyvr_ffmpeg_${component} PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${CYVR_PLAYER_FFMPEG_ROOT}/include")
    if(WIN32)
        file(GLOB component_dll "${CYVR_PLAYER_FFMPEG_ROOT}/bin/${component}-*.dll")
        list(LENGTH component_dll dll_count)
        if(NOT dll_count EQUAL 1)
            message(FATAL_ERROR "Expected exactly one ${component} DLL in the SDK")
        endif()
        set_target_properties(cyvr_ffmpeg_${component} PROPERTIES
            IMPORTED_LOCATION "${component_dll}"
            IMPORTED_IMPLIB "${CYVR_PLAYER_FFMPEG_ROOT}/lib/${component}.lib")
    else()
        set_target_properties(cyvr_ffmpeg_${component} PROPERTIES
            IMPORTED_LOCATION "${CYVR_PLAYER_FFMPEG_ROOT}/lib/lib${component}.so")
    endif()
endforeach()
if(WIN32)
    file(GLOB ffmpeg_runtime_dlls "${CYVR_PLAYER_FFMPEG_ROOT}/bin/*.dll")
    file(COPY ${ffmpeg_runtime_dlls} DESTINATION "${CMAKE_CURRENT_BINARY_DIR}")
endif()
