if(ANDROID)
    set(disc_platform android)
else()
    set(disc_platform windows)
endif()
set(CYVR_DISC_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.deps/discs/${disc_platform}" CACHE PATH "Pinned static VideoLAN disc readers")
foreach(name bluray dvdread udfread)
    find_library(disc_${name} NAMES ${name} lib${name} PATHS "${CYVR_DISC_ROOT}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
    add_library(cyvr_${name} STATIC IMPORTED)
    set_target_properties(cyvr_${name} PROPERTIES IMPORTED_LOCATION "${disc_${name}}" INTERFACE_INCLUDE_DIRECTORIES "${CYVR_DISC_ROOT}/include")
endforeach()
target_link_libraries(cyvr_bluray INTERFACE cyvr_udfread)
if(WIN32)
    target_link_libraries(cyvr_bluray INTERFACE advapi32 shell32 ole32)
else()
    target_link_libraries(cyvr_bluray INTERFACE dl)
    target_link_libraries(cyvr_dvdread INTERFACE dl)
endif()
